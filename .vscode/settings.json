{
    "chat.useNestedAgentsMdFiles": true,
    "chat.useClaudeMdFile": false,
    "github.copilot.chat.codeGeneration.useInstructionFiles": false,
    "python.analysis.extraPaths": [
        "${workspaceFolder}/code/src",
        "${workspaceFolder}/research/references/src"
    ],
    "python.autoComplete.extraPaths": [
        "${workspaceFolder}/code/src",
        "${workspaceFolder}/research/references/src"
    ],
    "vsicons.associations.folders": [
        {
            "icon": "src",
            "extensions": [
                "code"
            ],
            "format": "svg"
        },
        {
            "icon": "library",
            "extensions": [
                "research"
            ],
            "format": "svg"
        },
        {
            "icon": "docs",
            "extensions": [
                "publications"
            ],
            "format": "svg"
        }
    ],
    // LaTeX Workshop Configuration
    "latex-workshop.latex.recipes": [
        {
            "name": "pdfLaTeX (quick)",
            "tools": [
                "pdflatex"
            ]
        },
        {
            "name": "pdfLaTeX -> Biber -> pdfLaTeX x2 (full)",
            "tools": [
                "pdflatex",
                "biber",
                "pdflatex",
                "pdflatex"
            ]
        },
        {
            "name": "pdfLaTeX -> BibTeX -> pdfLaTeX x2 (full)",
            "tools": [
                "pdflatex",
                "bibtex",
                "pdflatex",
                "pdflatex"
            ]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "pdflatex",
            "command": "pdflatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "--aux-directory=.latex_build",
                "%DOC%"
            ],
            "env": {}
        },
        {
            "name": "biber",
            "command": "biber",
            "args": [
                "--input-directory=.latex_build",
                "--output-directory=.latex_build",
                "%DOCFILE%"
            ],
            "env": {}
        },
        {
            "name": "bibtex",
            "command": "bibtex",
            "args": [
                ".latex_build/%DOCFILE%"
            ],
            "env": {}
        }
    ],
    "latex-workshop.latex.autoBuild.run": "never",
    "latex-workshop.latex.recipe.default": "first",
    "latex-workshop.latex.outDir": ".",
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",
    "latex-workshop.latex.clean.subfolder.enabled": true,
    "latex-workshop.latex.clean.method": "glob",
    "latex-workshop.latex.autoClean.run": "never"
}
