# Auto detect text files and perform LF normalization
* text=auto

# Binary files: never convert line endings or attempt text merges.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.zip binary
*.gz binary
*.npy binary
*.npz binary
*.h5 binary
*.pkl binary
*.xlsx binary
*.docx binary
*.pptx binary

# Expensive or irreplaceable results are stored byte for byte, with no
# line-ending conversion. See docs/agent-guidance/data-preservation.md.
/data/** -text
/data/README.md text

# Shell scripts must keep LF endings, or sh fails on Linux and macOS.
*.sh text eol=lf
